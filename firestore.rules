rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gestionnaire : uniquement le compte sas61ana@gmail.com, adresse vérifiée
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "sas61ana@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function hasAccess() {
      return request.auth != null && exists(/databases/$(database)/documents/access/$(request.auth.uid));
    }
    function myEmp() {
      return get(/databases/$(database)/documents/access/$(request.auth.uid)).data.empId;
    }

    match /config/{doc}  { allow read, write: if isAdmin(); }
    match /weeks/{week}  { allow read, write: if isAdmin(); }

    match /access/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    match /logins/{empId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
    match /annuaire/{doc} {
      allow read: if isAdmin() || hasAccess();
      allow write: if isAdmin();
    }
    match /publies/{empId}/semaines/{week} {
      allow read: if isAdmin() || (hasAccess() && myEmp() == empId);
      allow write: if isAdmin();
    }
    match /publies/{empId}/rh/{doc} {
      allow read: if isAdmin() || (hasAccess() && myEmp() == empId);
      allow write: if isAdmin();
    }
    // accusés de lecture, acceptation du règlement, préparation d'entretien : écrits par le collaborateur lui-même
    match /suivi/{id} {
      allow read: if isAdmin() || (hasAccess() && resource.data.empId == myEmp());
      allow create: if hasAccess()
        && request.resource.data.empId == myEmp()
        && id.matches(myEmp() + "_.+")
        && request.resource.data.kind in ["lecture", "reglement", "annonce", "entretien"];
      allow update: if isAdmin() || (hasAccess()
        && resource.data.empId == myEmp()
        && request.resource.data.empId == myEmp()
        && request.resource.data.kind == resource.data.kind);
      allow delete: if isAdmin();
    }
    match /annonces/{id} {
      allow read: if isAdmin() || hasAccess();
      allow write: if isAdmin();
    }
    // journal des actions : ajout seulement, jamais modifié ni supprimé
    match /journal/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /demandes/{id} {
      allow read: if isAdmin() || (hasAccess() && resource.data.empId == myEmp());
      allow create: if hasAccess()
        && request.resource.data.empId == myEmp()
        && request.resource.data.status == "attente"
        && request.resource.data.type in ["CP", "ECHANGE", "ERREUR", "ABSENCE"];
      allow update, delete: if isAdmin();
    }
    match /pauses/{id} {
      allow read: if isAdmin() || (hasAccess() && resource.data.empId == myEmp());
      allow create: if hasAccess()
        && request.resource.data.empId == myEmp()
        && request.resource.data.type in ["pause", "wc"]
        && request.resource.data.end == null
        && request.resource.data.startAt == request.time
        && request.resource.data.qr == get(/databases/$(database)/documents/config/pause).data.qr;
      allow update: if isAdmin() || (hasAccess()
        && resource.data.empId == myEmp()
        && resource.data.end == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["end", "endAt", "endQr", "noScan"])
        && request.resource.data.endAt == request.time
        && (request.resource.data.get("noScan", false) == true
            || request.resource.data.endQr == get(/databases/$(database)/documents/config/pause).data.qr));
      allow delete: if isAdmin();
    }
    match /realises/{id} {
      allow read: if isAdmin() || (hasAccess() && resource.data.empId == myEmp());
      allow create: if isAdmin() || (hasAccess()
        && id == myEmp() + "_" + request.resource.data.day
        && request.resource.data.empId == myEmp()
        && request.resource.data.status == "attente");
      allow update: if isAdmin() || (hasAccess()
        && resource.data.empId == myEmp()
        && resource.data.status != "validé"
        && request.resource.data.empId == myEmp()
        && request.resource.data.status == "attente");
      allow delete: if isAdmin();
    }
    match /resultats/{day} {
      allow read: if isAdmin() || hasAccess();
      allow write: if isAdmin();
      match /parts/{part} {
        allow read: if isAdmin() || hasAccess();
        allow write: if isAdmin();
      }
    }
    match /palmares/{day} {
      allow read, write: if isAdmin();
    }
  }
}
